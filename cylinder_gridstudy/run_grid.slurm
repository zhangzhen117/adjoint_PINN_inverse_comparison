#!/bin/bash
#SBATCH --job-name=cylgrid
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH --cpus-per-task=1
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%A_%a.log

# Cylinder grid-independence study, one array task per case.
#   sbatch run_grid.slurm
# Cases are generated by mkcase.py; the ordering below must match CASES.

set -o pipefail

module purge
module load gcc/11.5.0-wfyo openmpi/4.1.8-iqkf
source /oscar/data/gk/zzhan536/OpenFOAM/OpenFOAM-v2512/etc/bashrc \
    || { echo "FAILED to source OpenFOAM bashrc"; exit 1; }

CASES=(L1_trans L2_trans L3_trans L4_trans L3dt0.0025_trans)

NAME="${CASES[$SLURM_ARRAY_TASK_ID]}"
CASE="$SLURM_SUBMIT_DIR/cases/$NAME"
cd "$CASE" || { echo "no case $CASE"; exit 1; }

SOLVER=pimpleFoam

# Ranks scaled to mesh size: below roughly 3000 cells per rank the halo exchange
# costs more than the solve, and the coarse cases ran slower on 8 ranks than the
# fine ones did on 16.
declare -A RANKS=( [L1_trans]=4 [L2_trans]=8 [L3_trans]=16 [L4_trans]=16
                   [L3dt0.0025_trans]=16 )
NP=${RANKS[$NAME]:-8}
cat > system/decomposeParDict <<EOF
FoamFile { version 2.0; format ascii; class dictionary; object decomposeParDict; }
numberOfSubdomains $NP;
method          scotch;
EOF

echo "=== $NAME | $SOLVER | np=$NP | $(hostname) | $(date) ==="

rm -rf processor* postProcessing constant/polyMesh
blockMesh 2>&1 | tee log.blockMesh | tail -3
checkMesh 2>&1 | tee log.checkMesh | grep -E 'nCells|non-orthogonality|skewness|Mesh OK|FAILED'

decomposePar -force 2>&1 | tee log.decomposePar | tail -2
mpirun -np "$NP" "$SOLVER" -parallel 2>&1 | tee "log.$SOLVER" | tail -5
rc=$?

# Probe and force output is written per-processor-0 under postProcessing already;
# reconstruct only the final field for plotting, not the whole time history.
reconstructPar -latestTime 2>&1 | tee log.reconstructPar | tail -2

echo "=== done $NAME rc=$rc $(date) ==="
