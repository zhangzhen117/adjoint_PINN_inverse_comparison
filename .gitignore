# Python bytecode caches
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Environments / editors
.venv/
venv/
.env
.vscode/
.idea/
.DS_Store

# Overleaf manuscript working copy (separate git remote; do not nest here)
paper_overleaf/

# SLURM job logs
*.log
*.err
slurm-*.out

# Sweep outputs (regenerate via sbatch slurm/run_sweep.sh)
results/*_runs*/

# Scratch figures for inspection
debug/

# OpenFOAM case directories: 2.3 GB of decomposed mesh and per-processor field
# output across seven meshes. Regenerate with
#   python cases/case4_cylinder/gridstudy/mkcase.py && sbatch slurm/run_grid.slurm
# The derived results (grid_report.txt, *_data.npz, the inversion histories) are
# small and are tracked.
cases/case4_cylinder/gridstudy/cases/
cases/case4_cylinder/gridstudy/logs/
cases/case4_cylinder/gridstudy/figures/

# Superseded or retracted run data, kept locally for provenance but not shipped
*.jsonl.bak
results/*_invalid*/

# local session helper, not part of the project
claude_resume
